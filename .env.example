# Radar reads these from real environment variables, not from this file. Copy the ones you need
# into your shell/user environment; .env itself is git-ignored and never read automatically.

# Gemini API key used for release explanations and AI summaries. Required to use those features;
# without it Radar keeps working, it just skips anything that needs Gemini.
GEMINI_API_KEY=

# Gemini model name. Optional; defaults to gemini-3.8-flash when unset.
GEMINI_MODEL=

# Overrides where Radar looks for its .prompt.md/.schema.json files. Optional; defaults to the
# "Prompts" folder next to the running executable (Radar.Desktop.exe or Radar.Worker.exe).
RADAR_PROMPTS_DIR=
