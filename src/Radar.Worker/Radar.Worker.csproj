<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Radar.Worker-29c1148b-0205-46da-a240-5e2eaa4fa33f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Radar.Core\Radar.Core.csproj" />
    <ProjectReference Include="..\Radar.Infrastructure\Radar.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Radar.Infrastructure's own output is not copied downstream automatically, so link the same prompt files here. -->
  <ItemGroup>
    <None Include="..\Radar.Infrastructure\Prompts\**\*.prompt.md;..\Radar.Infrastructure\Prompts\**\*.schema.json">
      <Link>Prompts\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
