{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "GitHubMonitor": {
    "PollingInterval": "01:00:00",
    "NewSourceCheckInterval": "00:01:00"
  },
  "YouTubeMonitor": {
    "PollingInterval": "00:15:00",
    "NewSourceCheckInterval": "00:01:00"
  },
  "Summaries": {
