<UserControl x:Class="Radar.Desktop.ReleaseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Radar.Core.Contents;assembly=Radar.Core">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <DockPanel Margin="48,24,48,32">

            <!-- Back + metadata + title + one-line summary -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
                <Button Content="← Novedades" Style="{StaticResource TextLinkButton}" Click="Back_Click"
                        HorizontalAlignment="Left" Margin="0,0,0,6" Padding="0,6" />
                <TextBlock Text="{Binding MetaLine}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Resumen}" FontSize="18" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="{Binding ShowResumen, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="Preparando la ficha…" FontSize="14" Margin="0,10,0,0" Foreground="{DynamicResource MutedTextBrush}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <!-- Main column fills the width; the aside sits to its right, or below it when the window is narrow (see SizeChanged). -->
            <Grid x:Name="BodyGrid" SizeChanged="BodyGrid_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="AsideColumn" Width="260" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Main column -->
                <StackPanel x:Name="MainColumn" Grid.Column="0" Margin="0,0,56,0">

                    <!-- Te afecta -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28"
                                Visibility="{Binding ShowAffects, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,8,10,0" VerticalAlignment="Top" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14">
                            <Run Text="{Binding AffectsLead}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
                            <Run Text=" " /><Run Text="{Binding AffectsText}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Qué hay de nuevo -->
                    <StackPanel Margin="0,0,0,28" Visibility="{Binding ShowCambios, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Qué hay de nuevo" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Cambios}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:ReleaseChange}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TagText" Grid.Column="0" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Texto}" FontSize="14" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Tipo}" Value="{x:Static core:ReleaseChangeType.Nuevo}">
                                            <Setter TargetName="TagText" Property="Text" Value="Nuevo" />
                                            <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tipo}" Value="{x:Static core:ReleaseChangeType.Cambio}">
                                            <Setter TargetName="TagText" Property="Text" Value="Cambio" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tipo}" Value="{x:Static core:ReleaseChangeType.Arreglo}">
                                            <Setter TargetName="TagText" Property="Text" Value="Arreglo" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tipo}" Value="{x:Static core:ReleaseChangeType.Importante}">
                                            <Setter TargetName="TagText" Property="Text" Value="Importante" />
                                            <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Instalación -->
                    <StackPanel Margin="0,0,0,28" Visibility="{Binding ShowInstalacion, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Instalación" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding InstallSystemLabel}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="0,6">
                            <ItemsControl ItemsSource="{Binding Instalacion}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="16,6,8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayText}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                            <Button Grid.Column="1" Content="⧉" Style="{StaticResource TextLinkButton}" Padding="8,4"
                                                    Click="CopyCommand_Click" AutomationProperties.Name="Copiar comando" ToolTip="Copiar comando" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- Plan de uso -->
                    <StackPanel Margin="0,0,0,28" Visibility="{Binding ShowPlanDeUso, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Plan de uso" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding PlanDeUso}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Footer -->
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="{Binding NotesToggleLabel}" Style="{StaticResource TextLinkButton}" Click="ToggleNotes_Click"
                                        Padding="0,6" Margin="0,0,20,0"
                                        Visibility="{Binding ShowNotesToggle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0"
                                            Visibility="{Binding ShowAiBadge, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="✦" FontSize="12" Foreground="{DynamicResource AiBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Resumen generado con IA" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Regenerar" Style="{StaticResource TextLinkButton}" Click="Regenerate_Click" Padding="0,6"
                                        Visibility="{Binding ShowRegenerate, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="{Binding UnavailableReason}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="{Binding ShowUnavailableReason, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Notes}" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,0"
                                       Foreground="{DynamicResource BodyTextBrush}"
                                       Visibility="{Binding ShowNotes, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Aside -->
                <StackPanel x:Name="AsidePanel" Grid.Column="1">
                    <Button Content="Ya lo instalé" Style="{StaticResource PrimaryButton}" Height="42" IsEnabled="False"
                            ToolTip="Próximamente (Mi stack)" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,8" />
                    <Button Content="{Binding OpenLinkLabel}" Style="{StaticResource ActionButton}" Click="OpenLink_Click" Margin="0,0,0,24" />

                    <ItemsControl ItemsSource="{Binding Versiones}"
                                  Visibility="{Binding ShowVersiones, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:VersionEntry}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Etiqueta}" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Valor}" FontSize="13" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DockPanel>
    </ScrollViewer>
</UserControl>
