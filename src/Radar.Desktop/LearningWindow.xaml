<Window x:Class="Radar.Desktop.LearningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aprender Gentle AI" Height="720" Width="1000" MinHeight="480" MinWidth="760"
        Background="{DynamicResource PageBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style x:Key="OptionRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with the three views -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,12,20,0">
            <StackPanel>
                <TextBlock Text="Aprender Gentle AI" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,8"
                           Text="Estudia los conceptos de Gentle AI y practica para tu examen técnico." />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LearnTab" Content="Aprender" Style="{StaticResource TabButton}" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="ExamsTab" Content="Exámenes" Style="{StaticResource TabButton}" Checked="Tab_Checked" />
                    <RadioButton x:Name="ProgressTab" Content="Mi progreso" Style="{StaticResource TabButton}" Checked="Tab_Checked" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Aprender -->
        <Grid x:Name="LearnView" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0" Padding="12,12">
                <ListBox x:Name="TopicsList" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource PlainListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="TopicsList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="8,10,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,7">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                <StackPanel x:Name="TopicPanel" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock x:Name="TopicTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" />
                    <DockPanel Margin="0,4,0,0" LastChildFill="False">
                        <TextBlock x:Name="TopicSubtitle" DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Button x:Name="MarkStudiedButton" DockPanel.Dock="Right" Content="Marcar como estudiado"
                                Style="{StaticResource PrimaryButton}" Click="MarkStudied_Click" />
                        <Button x:Name="MarkPendingButton" DockPanel.Dock="Right" Content="Volver a pendiente"
                                Style="{StaticResource ActionButton}" Click="MarkPending_Click" />
                    </DockPanel>

                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0" FontStyle="Italic"
                               Text="Las secciones siguientes son explicaciones didácticas basadas en la documentación. Lo verificado en la fuente oficial aparece en «Confirmado en la documentación oficial»." />

                    <TextBlock Text="Qué es" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="WhatItIsText" Style="{StaticResource BodyText}" />
                    <TextBlock Text="Para qué sirve" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="WhatItIsForText" Style="{StaticResource BodyText}" />
                    <TextBlock Text="Cómo funciona" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="HowItWorksText" Style="{StaticResource BodyText}" />
                    <TextBlock Text="Ejemplo práctico" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="ExampleText" Style="{StaticResource BodyText}" />
                    <TextBlock Text="Diferencias con conceptos relacionados" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="DifferencesText" Style="{StaticResource BodyText}" />

                    <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}">
                        <StackPanel>
                            <TextBlock Text="Confirmado en la documentación oficial" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock x:Name="ConfirmedText" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,0">
                        <Run Text="Fuente: " />
                        <Hyperlink x:Name="SourceLink" Click="SourceLink_Click">
                            <Run x:Name="SourceUrlText" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock x:Name="SourceReferenceText" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,8" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Exámenes -->
        <ScrollViewer x:Name="ExamsView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16" Visibility="Collapsed">
            <Grid MaxWidth="760" HorizontalAlignment="Left">

                <!-- Setup -->
                <StackPanel x:Name="ExamSetupPanel">
                    <TextBlock Text="Nuevo examen" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />

                    <TextBlock Text="Tema" Style="{StaticResource SectionLabel}" />
                    <ComboBox x:Name="ExamTopicCombo" Width="420" HorizontalAlignment="Left" DisplayMemberPath="Title"
                              SelectionChanged="ExamTopicCombo_SelectionChanged" />

                    <TextBlock Text="Número de preguntas" Style="{StaticResource SectionLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Count5" Content="5" Tag="5" GroupName="Count" Style="{StaticResource OptionRadio}" IsChecked="True" />
                        <RadioButton Content="10" Tag="10" GroupName="Count" Style="{StaticResource OptionRadio}" />
                        <RadioButton Content="20" Tag="20" GroupName="Count" Style="{StaticResource OptionRadio}" />
                    </StackPanel>

                    <TextBlock Text="Dificultad" Style="{StaticResource SectionLabel}" />
                    <StackPanel x:Name="DifficultyOptions" Orientation="Horizontal">
                        <RadioButton Content="Básica" Tag="Basic" GroupName="Difficulty" Style="{StaticResource OptionRadio}" />
                        <RadioButton Content="Variada" Tag="Mixed" GroupName="Difficulty" Style="{StaticResource OptionRadio}" IsChecked="True" />
                        <RadioButton Content="Avanzada" Tag="Advanced" GroupName="Difficulty" Style="{StaticResource OptionRadio}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Empezar examen" Style="{StaticResource PrimaryButton}" Margin="0" Click="StartExam_Click" />
                        <Button x:Name="RepeatLastFailedButton" Content="Repetir falladas del último examen"
                                Style="{StaticResource ActionButton}" Click="RepeatLastFailed_Click" />
                    </StackPanel>

                    <Border Margin="0,24,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Más preguntas con IA" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />
                                <Button x:Name="GenerateQuestionsButton" DockPanel.Dock="Right" Content="Generar preguntas con IA"
                                        Style="{StaticResource ActionButton}" Click="GenerateQuestions_Click" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Text="Gemini crea preguntas solo a partir de los hechos confirmados del tema elegido. Las preguntas repetidas se descartan y cada pregunta muestra su origen." />
                            <TextBlock x:Name="GenerateStatus" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Question -->
                <StackPanel x:Name="QuestionPanel" Visibility="Collapsed">
                    <TextBlock x:Name="QuestionHeader" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="QuestionText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,12"
                               Foreground="{DynamicResource TextBrush}" />
                    <ListBox x:Name="OptionsList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OptionsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,9">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="FeedbackPanel" Margin="0,12,0,0" Padding="14,10" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource SurfaceBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="FeedbackTitle" FontWeight="SemiBold" />
                            <TextBlock x:Name="FeedbackText" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                            <TextBlock x:Name="FeedbackOrigin" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="AnswerButton" Content="Responder" Style="{StaticResource PrimaryButton}" Margin="0"
                                IsEnabled="False" Click="Answer_Click" />
                        <Button x:Name="NextButton" Content="Siguiente" Style="{StaticResource PrimaryButton}" Margin="0"
                                Visibility="Collapsed" Click="Next_Click" />
                        <Button Content="Abandonar examen" Style="{StaticResource ActionButton}" Click="QuitExam_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Result -->
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock Text="Resultado" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="ScoreText" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Temas que conviene repasar" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="ReviewTopicsText" Style="{StaticResource BodyText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button x:Name="RepeatFailedButton" Content="Repetir preguntas falladas" Style="{StaticResource PrimaryButton}"
                                Margin="0" Click="RepeatFailed_Click" />
                        <Button Content="Nuevo examen" Style="{StaticResource ActionButton}" Click="NewExam_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Mi progreso -->
        <ScrollViewer x:Name="ProgressView" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16" Visibility="Collapsed">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock x:Name="ProgressSummary" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />

                <TextBlock Text="Resultados de exámenes" Style="{StaticResource SectionLabel}" />
                <TextBlock x:Name="NoAttemptsText" Style="{StaticResource MutedText}" Text="Todavía no has hecho ningún examen." />
                <ItemsControl x:Name="AttemptsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ScoreText}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Temas pendientes" Style="{StaticResource SectionLabel}" />
                <TextBlock x:Name="PendingTopicsText" Style="{StaticResource BodyText}" />

                <TextBlock Text="Conceptos con más errores" Style="{StaticResource SectionLabel}" />
                <TextBlock x:Name="MistakesText" Style="{StaticResource BodyText}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" />
        </Border>
    </Grid>
</Window>
