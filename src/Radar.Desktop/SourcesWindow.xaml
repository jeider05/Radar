<Window x:Class="Radar.Desktop.SourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My sources" Height="560" Width="720" MinHeight="380" MinWidth="560"
        Background="{DynamicResource PageBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20,16,20,20">
        <TextBlock DockPanel.Dock="Top" Text="My sources" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />
        <TextBlock DockPanel.Dock="Top" Margin="0,2,0,14" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                   Text="GitHub repositories (releases) and YouTube channels (new videos) that Radar follows. New sources are checked by the Worker within about a minute." />

        <!-- Add a source -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Add a source" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="GitHubTypeButton" Content="GitHub repository" Style="{StaticResource TabButton}"
                                     IsChecked="True" Checked="SourceType_Checked" />
                        <RadioButton x:Name="YouTubeTypeButton" Content="YouTube channel" Style="{StaticResource TabButton}"
                                     Checked="SourceType_Checked" />
                    </StackPanel>
                </Border>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RepositoryInput" Padding="6,5" VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource BorderBrush}" KeyDown="RepositoryInput_KeyDown"
                             />
                    <TextBlock x:Name="InputHint" IsHitTestVisible="False" Margin="9,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}" Text="owner/repository or GitHub URL">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=RepositoryInput}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="AddButton" Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Click="Add_Click" />
                </Grid>
                <TextBlock x:Name="AddMessage" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Registered sources -->
        <Grid>
            <TextBlock x:Name="EmptyText" Text="No sources yet. Add a repository above."
                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" />

            <ListBox x:Name="SourcesList" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="{Binding ToggleText}" Style="{StaticResource ActionButton}" Click="Toggle_Click" />
                                    <Button Content="Remove" Style="{StaticResource ActionButton}" Click="Remove_Click"
                                            IsEnabled="{Binding CanRemove}" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="{Binding RemoveToolTip}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
