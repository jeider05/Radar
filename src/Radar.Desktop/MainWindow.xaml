<Window x:Class="Radar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radar" Height="640" Width="1040" MinHeight="420" MinWidth="720"
        Background="{DynamicResource PageBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Refresh, theme toggle and status stay here; navigation moved into the sidebar. -->
        <Border Grid.Row="0" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" />
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Click="Theme_Click" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: logo, primary navigation, sources grouped by type, add a source. -->
            <Border Grid.Column="0" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="0,16,0,16">

                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,0,20,20">
                        <Canvas Width="20" Height="20" Margin="0,0,8,0">
                            <Ellipse Width="20" Height="20" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="5" Canvas.Top="5" Width="10" Height="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
                            <Line X1="10" Y1="10" X2="18" Y2="2" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                        <TextBlock Text="Radar" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Add a source -->
                    <Button DockPanel.Dock="Bottom" Content="＋ Agregar fuente" Style="{StaticResource SidebarNavButton}"
                            Margin="12,8,12,0" Click="ManageSources_Click" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,0,12,0">
                            <!-- Primary navigation -->
                            <Button Content="Guías" Style="{StaticResource SidebarNavButton}" IsEnabled="False"
                                    ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Mi stack" Style="{StaticResource SidebarNavButton}" IsEnabled="False"
                                    ToolTip="Próximamente" ToolTipService.ShowOnDisabled="True" />
                            <Button Content="Aprender Gentle AI" Style="{StaticResource SidebarNavButton}" Click="Learn_Click" />

                            <!-- "Novedades" (all sources) plus every source, grouped as Repositorios/Canales. -->
                            <ListBox x:Name="SourcesList" BorderThickness="0" Background="Transparent" Margin="0,8,0,0"
                                     ItemContainerStyle="{StaticResource PlainListItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     SelectionChanged="SourcesList_SelectionChanged">
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="HeaderText" Text="{Binding Name}" FontSize="12"
                                                           Foreground="{DynamicResource MutedTextBrush}" Margin="8,16,0,6" />
                                                <DataTemplate.Triggers>
                                                    <!-- "Novedades" uses an empty group name so it shows no header. -->
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="36" Margin="8,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NameText" Grid.Column="0" Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- "Novedades": total unread as text. Any other source: a small dot when it has unread items. -->
                                            <TextBlock Grid.Column="1" Text="{Binding UnreadText}" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="8,0,0,0"
                                                       Visibility="{Binding IsAllFilter, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Ellipse Grid.Column="1" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="8,0,2,0"
                                                     Visibility="{Binding ShowUnreadDot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content list -->
            <DockPanel Grid.Column="1" Margin="20,16,20,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="ListTitle" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="ListSummary" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Period tabs -->
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="All" Tag="All" Style="{StaticResource TabButton}" IsChecked="True" Checked="Period_Checked" />
                        <RadioButton Content="Today" Tag="Today" Style="{StaticResource TabButton}" Checked="Period_Checked" />
                        <RadioButton Content="This month" Tag="ThisMonth" Style="{StaticResource TabButton}" Checked="Period_Checked" />
                        <RadioButton Content="This year" Tag="ThisYear" Style="{StaticResource TabButton}" Checked="Period_Checked" />
                    </StackPanel>
                </Border>

                <!-- Pagination -->
                <StackPanel x:Name="Pager" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,8,0,12" Visibility="Collapsed">
                    <Button x:Name="PreviousPageButton" Content="Previous" Style="{StaticResource ActionButton}" Click="PreviousPage_Click" />
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
                    <Button x:Name="NextPageButton" Content="Next" Style="{StaticResource ActionButton}" Click="NextPage_Click" />
                </StackPanel>

                <Grid>
                    <TextBlock x:Name="EmptyText" Text="No content yet. The Worker adds new releases as it finds them."
                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed" />

                    <ListBox x:Name="ItemsList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Unread marker -->
                                        <Ellipse x:Name="UnreadDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                 ToolTip="Unread" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="12">
                                                <Run Text="{Binding SourceName, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding DateText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button x:Name="MarkAsReadButton" Content="Mark as read" Style="{StaticResource ActionButton}"
                                                    Click="MarkAsRead_Click" />
                                            <Button Content="Details" Style="{StaticResource ActionButton}" Click="Details_Click"
                                                    ToolTip="Release notes and AI explanation" />
                                            <Button Content="Open" Style="{StaticResource ActionButton}" Click="Open_Click"
                                                    ToolTip="{Binding Url}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                        <Setter TargetName="UnreadDot" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="TitleText" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                        <Setter TargetName="MarkAsReadButton" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
