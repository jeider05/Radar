<Window x:Class="Radar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radar" Height="640" Width="1040" MinHeight="420" MinWidth="720"
        Background="{StaticResource PageBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Shared look for the sidebar entries and the content cards: no default blue selection chrome. -->
        <Style x:Key="PlainListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="0,0,0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Radar" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" />
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sources sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0" Padding="12,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SOURCES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,8" />
                    <ListBox x:Name="SourcesList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SourcesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding UnreadText}" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Content list -->
            <DockPanel Grid.Column="1" Margin="20,16,20,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock x:Name="ListTitle" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="ListSummary" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <Grid>
                    <TextBlock x:Name="EmptyText" Text="No content yet. The Worker adds new releases as it finds them."
                               Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Visibility="Collapsed" />

                    <ListBox x:Name="ItemsList" BorderThickness="0" Background="Transparent"
                             ItemContainerStyle="{StaticResource PlainListItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Unread marker -->
                                        <Ellipse x:Name="UnreadDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                                                 VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                 ToolTip="Unread" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12">
                                                <Run Text="{Binding SourceName, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding DateText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button x:Name="MarkAsReadButton" Content="Mark as read" Style="{StaticResource ActionButton}"
                                                    Click="MarkAsRead_Click" />
                                            <Button Content="Open" Style="{StaticResource ActionButton}" Click="Open_Click"
                                                    ToolTip="{Binding Url}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                        <Setter TargetName="UnreadDot" Property="Visibility" Value="Hidden" />
                                        <Setter TargetName="TitleText" Property="FontWeight" Value="Normal" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                        <Setter TargetName="MarkAsReadButton" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
