<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Light.xaml defines the same keys. -->
    <SolidColorBrush x:Key="PageBrush" Color="#0E1116" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#141920" />
    <SolidColorBrush x:Key="HoverBrush" Color="#181D24" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#181D24" />
    <SolidColorBrush x:Key="BorderBrush" Color="#252C35" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1C2229" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E9ED" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C9CFD6" />
    <SolidColorBrush x:Key="BodyTextBrush" Color="#AEB6C0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8E98A4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F5B544" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#1A1206" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#F5B544" />
    <SolidColorBrush x:Key="AiBrush" Color="#B9A8F8" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#6FD6A3" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F97066" />
</ResourceDictionary>
