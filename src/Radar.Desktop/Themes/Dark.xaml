<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Light.xaml defines the same keys. -->
    <SolidColorBrush x:Key="PageBrush" Color="#0F1115" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#181B21" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2C313A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#222730" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#1E2B45" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E8EB" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3AE" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4F8BF5" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F97066" />
</ResourceDictionary>
