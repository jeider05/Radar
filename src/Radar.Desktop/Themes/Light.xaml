<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Dark.xaml defines the same keys. -->
    <SolidColorBrush x:Key="PageBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E4E8" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E3ECFA" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#656D76" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
</ResourceDictionary>
