<UserControl x:Class="Radar.Desktop.NovedadesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel Margin="48,24,48,0" MaxWidth="760" HorizontalAlignment="Center">

        <!-- Header: title + unread count (left), status, refresh and theme (right). -->
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock x:Name="HeaderTitleText" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="HeaderUnreadText" Margin="12,0,0,0" VerticalAlignment="Bottom" Padding="0,0,0,3"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Click="Theme_Click" />
            <Button DockPanel.Dock="Right" Content="⟳" FontSize="15" Style="{StaticResource ActionButton}" Click="Refresh_Click"
                    AutomationProperties.Name="Actualizar" ToolTip="Actualizar" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </DockPanel>

        <!-- "Tu radar hoy": one line, only for "Novedades" (all sources), only when a digest exists. -->
        <StackPanel x:Name="DigestPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20" Visibility="Collapsed">
            <TextBlock Text="✦" FontSize="14" Foreground="{DynamicResource AiBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="DigestText" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Periods and type filter in one row. -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton Content="Todo" Tag="All" Style="{StaticResource TabButton}" IsChecked="True" Checked="Period_Checked" />
                    <RadioButton Content="Hoy" Tag="Today" Style="{StaticResource TabButton}" Checked="Period_Checked" />
                    <RadioButton Content="Este mes" Tag="ThisMonth" Style="{StaticResource TabButton}" Checked="Period_Checked" />
                    <RadioButton Content="Este año" Tag="ThisYear" Style="{StaticResource TabButton}" Checked="Period_Checked" />
                </StackPanel>
                <ComboBox x:Name="TypeFilterCombo" DockPanel.Dock="Right" Width="150" VerticalAlignment="Center"
                          SelectionChanged="TypeFilter_SelectionChanged">
                    <ComboBoxItem Content="Todos los tipos" Tag="All" IsSelected="True" />
                    <ComboBoxItem Content="Releases" Tag="Release" />
                    <ComboBoxItem Content="Videos" Tag="Video" />
                </ComboBox>
            </DockPanel>
        </Border>

        <!-- Pagination -->
        <StackPanel x:Name="Pager" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="0,8,0,16" Visibility="Collapsed">
            <Button x:Name="PreviousPageButton" Content="Anterior" Style="{StaticResource ActionButton}" Click="PreviousPage_Click" />
            <TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="14,0,8,0" Foreground="{DynamicResource MutedTextBrush}" />
            <Button x:Name="NextPageButton" Content="Siguiente" Style="{StaticResource ActionButton}" Click="NextPage_Click" />
        </StackPanel>

        <Grid>
            <TextBlock x:Name="EmptyText" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" />

            <ListBox x:Name="ItemsList" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource PlainListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,22">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Video thumbnail; collapsed (0 width) for releases. -->
                                    <Grid Grid.Column="0" Width="176" Height="99" Margin="0,0,16,0" VerticalAlignment="Top"
                                          Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Border CornerRadius="8" Background="{DynamicResource HoverBrush}" />
                                        <Path Data="M 7,5 L 7,19 L 19,12 Z" Fill="{DynamicResource MutedTextBrush}"
                                              Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,176,99" RadiusX="8" RadiusY="8" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>

                                    <StackPanel Grid.Column="1">
                                        <!-- Metadata -->
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="UnreadDot" Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock FontSize="13">
                                                <Run Text="{Binding SourceName, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <Run Text=" · " Foreground="{DynamicResource MutedTextBrush}" />
                                                <Run Text="{Binding KindLabel, Mode=OneWay}" Foreground="{DynamicResource MutedTextBrush}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding DateText, Mode=OneWay}" FontSize="13" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </StackPanel>

                                        <!-- Title: opens Detalles. Wraps up to ~2 lines. -->
                                        <Button Style="{StaticResource TitleLinkButton}" Click="Details_Click" Margin="0,6,0,0"
                                                HorizontalAlignment="Stretch">
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="48" />
                                        </Button>

                                        <!-- Summary: ready bullets/phrase, or the pending notice. Nothing otherwise. -->
                                        <ItemsControl ItemsSource="{Binding SummaryBullets}" Margin="0,8,0,0"
                                                      Visibility="{Binding ShowReleaseBullets, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="14" Foreground="{DynamicResource BodyTextBrush}"
                                                               Margin="0,2,0,0" TextWrapping="Wrap">
                                                        <Run Text="•  " /><Run Text="{Binding Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding VideoSummaryText}" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource BodyTextBrush}"
                                                   Visibility="{Binding ShowVideoSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <TextBlock Text="Resumen en camino…" FontSize="13" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Visibility="{Binding ShowPending, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Actions: a discrete text row below the content, not a right-hand column. -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="MarkAsReadButton" Content="Marcar como leído" Style="{StaticResource TextLinkButton}"
                                            Click="MarkAsRead_Click" />
                                    <TextBlock Text="·" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Content="Detalles" Style="{StaticResource TextLinkButton}" Click="Details_Click" />
                                    <TextBlock Text="·" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <Button Content="Abrir" Style="{StaticResource TextLinkButton}" Click="Open_Click" ToolTip="{Binding Url}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                <Setter TargetName="UnreadDot" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="TitleText" Property="FontWeight" Value="Normal" />
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="MarkAsReadButton" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
